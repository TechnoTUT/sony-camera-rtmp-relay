# ==============================================================================
# Sony Camera RTMP Relay Configuration
# ==============================================================================

# [Required] Destination RTMP server URL where the relay forwards the stream
# e.g., rtmp://<destination-ip>:1935/live/test
SERVER_URL=rtmp://10.33.0.1:1935/live/test

# [Required] IP address of this relay server reachable from the Sony camera
# CoreDNS resolves 'api.ustream.tv' to this IP address
RELAY_IP=10.33.71.1

# [Optional] Upstream DNS server to forward other DNS queries
UPSTREAM_DNS=1.1.1.1

# [Optional] Host port mappings
HTTP_PORT=8080
RTMP_PORT=1935
DNS_PORT=53
